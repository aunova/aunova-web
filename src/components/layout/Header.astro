---
import { contact } from "../../utils/company";
import { getCurrentLanguage, getTranslation } from "../../utils/i18n";

const currentLang = getCurrentLanguage(Astro.url);
const t = getTranslation(currentLang);

// Language switch URLs for the current page
const pathname = Astro.url.pathname;
const pathWithoutLang = pathname.replace(/^\/(en|es)/, "") || "/";
const enUrl = pathWithoutLang === "/" ? "/" : `/en${pathWithoutLang}`;
const esUrl = `/es${pathWithoutLang === "/" ? "/" : pathWithoutLang}`;

// Section anchors live on the home page of the current language
const homeLink = currentLang === "es" ? "/es/" : "/";
const navItems = [
  { id: "services", label: t.nav.services },
  { id: "technology", label: t.nav.technology },
  { id: "impact", label: t.nav.impact },
  { id: "work", label: t.nav.work },
  { id: "process", label: t.nav.process },
];
---

<header class="site-header">
  <div class="container site-header__bar">
    <a href={homeLink} class="logo" aria-label={t.nav.home}>Aunova</a>

    <button
      class="menu-toggle"
      type="button"
      popovertarget="site-menu"
      aria-label={t.nav.menu}
    >
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
    </button>

    <div id="site-menu" class="site-menu" popover>
      <nav class="site-nav" aria-label={t.nav.primary}>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={`${homeLink}#${item.id}`} data-section={item.id}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-menu__actions">
        <a
          href={contact.booking}
          class="button button--primary site-menu__cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.nav.bookCall}<span class="sr-only"> ({t.nav.newTab})</span>
        </a>

        <details class="lang">
          <summary>
            <span class="sr-only">{t.nav.language}: </span>
            {currentLang.toUpperCase()}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M3 4.5L6 7.5L9 4.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </summary>
          <ul class="lang__menu">
            <li>
              <a
                href={enUrl}
                hreflang="en"
                lang="en"
                aria-current={currentLang === "en" ? "true" : undefined}
                >English</a
              >
            </li>
            <li>
              <a
                href={esUrl}
                hreflang="es"
                lang="es"
                aria-current={currentLang === "es" ? "true" : undefined}
                >Español</a
              >
            </li>
          </ul>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    height: var(--header-height);
    background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    view-transition-name: site-header;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    height: 100%;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  .logo:hover {
    text-decoration: none;
    opacity: 0.85;
  }

  /* Wide screens: the menu is an ordinary inline row (popover styles reset) */
  .site-menu {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    position: static;
    inset: auto;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    overflow: visible;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav li {
    margin: 0;
  }

  .site-nav a {
    position: relative;
    display: block;
    padding-block: var(--space-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .site-nav a:hover,
  .site-nav a[aria-current] {
    color: var(--color-primary);
    text-decoration: none;
  }

  .site-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    border-radius: 1px;
    background-color: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .site-nav a[aria-current]::after {
    transform: scaleX(1);
  }

  .site-menu__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .site-menu__cta {
    min-height: 2.5rem;
    padding: 0.5rem 1.25rem;
    font-size: 0.9375rem;
  }

  /* Language switcher: native <details>, works without JavaScript */
  .lang {
    position: relative;
  }

  .lang summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 2.5rem;
    padding: 0 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .lang summary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .lang[open] summary svg {
    transform: rotate(180deg);
  }

  .lang__menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: var(--z-dropdown);
    min-width: 9rem;
    margin: 0;
    padding: 4px;
    list-style: none;
    background-color: var(--color-background-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .lang__menu li {
    margin: 0;
  }

  .lang__menu a {
    display: block;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .lang__menu a:hover {
    background-color: color-mix(in srgb, var(--color-primary) 6%, transparent);
    text-decoration: none;
  }

  .lang__menu a[aria-current] {
    color: var(--color-primary);
    font-weight: 600;
  }

  .menu-toggle {
    display: none;
  }

  /* Narrow screens: the menu is a native popover, so it opens without JS */
  @media (max-width: 960px) {
    .menu-toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 44px;
      height: 44px;
      padding: 0 10px;
      margin-right: -10px;
      background: transparent;
      border: 0;
      cursor: pointer;
    }

    .menu-toggle__bar {
      display: block;
      height: 2px;
      border-radius: 1px;
      background-color: var(--color-primary);
      transition: transform var(--transition-base);
    }

    @supports selector(:popover-open) {
      .site-menu:not(:popover-open) {
        display: none;
      }

      .site-menu:popover-open {
        position: fixed;
        inset: var(--header-height) 0 0 0;
        width: auto;
        height: auto;
        max-width: none;
        max-height: none;
        flex-direction: column;
        align-items: stretch;
        justify-content: space-between;
        gap: var(--space-2xl);
        padding: var(--space-xl) var(--space-lg)
          calc(var(--space-xl) + env(safe-area-inset-bottom));
        background-color: var(--color-background);
        border-top: 1px solid var(--color-border);
        overflow-y: auto;
        overscroll-behavior: contain;
      }

      /* The panel starts below the header; let clicks reach the header toggle */
      .site-menu::backdrop {
        background: transparent;
        pointer-events: none;
      }

      .site-menu .site-nav ul {
        flex-direction: column;
        gap: 0;
      }

      .site-menu .site-nav a {
        padding-block: var(--space-md);
        font-family: var(--font-heading);
        font-size: 1.5rem;
        border-bottom: 1px solid var(--color-border);
      }

      .site-menu .site-nav a::after {
        display: none;
      }

      .site-menu .site-menu__actions {
        flex-direction: column;
        align-items: stretch;
      }

      .site-menu .site-menu__cta {
        min-height: 3rem;
        font-size: 1rem;
      }

      .site-menu .lang summary {
        width: 100%;
        justify-content: space-between;
      }

      .site-menu .lang__menu {
        position: static;
        margin-top: var(--space-sm);
        box-shadow: none;
      }

      :global(html:has(.site-menu:popover-open)) {
        overflow: hidden;
      }

      .site-header:has(.site-menu:popover-open) .menu-toggle__bar:first-child {
        transform: translateY(4px) rotate(45deg);
      }

      .site-header:has(.site-menu:popover-open) .menu-toggle__bar:last-child {
        transform: translateY(-4px) rotate(-45deg);
      }
    }

    /* Browsers without the Popover API keep the call button and language */
    @supports not selector(:popover-open) {
      .menu-toggle,
      .site-nav {
        display: none;
      }
    }
  }

  @media (max-width: 960px) and (prefers-reduced-motion: no-preference) {
    .site-menu:popover-open {
      animation: menu-in 220ms ease-out;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>

<script>
  // Progressive enhancements only: navigation works without this script.
  const menu = document.getElementById("site-menu");
  const lang = document.querySelector<HTMLDetailsElement>(".site-header .lang");

  // Close the mobile menu once a link inside it is chosen.
  menu?.addEventListener("click", (event) => {
    const link = (event.target as Element).closest("a");
    if (link && typeof menu.hidePopover === "function" && menu.matches(":popover-open")) {
      menu.hidePopover();
    }
  });

  // Close the language list on outside click or Escape.
  document.addEventListener("click", (event) => {
    if (lang?.open && !lang.contains(event.target as Node)) lang.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lang?.open) {
      lang.open = false;
      lang.querySelector("summary")?.focus();
    }
  });

  // Mark the nav link of the home section in view.
  const links = new Map<string, HTMLAnchorElement>();
  document
    .querySelectorAll<HTMLAnchorElement>(".site-nav a[data-section]")
    .forEach((link) => links.set(link.dataset.section ?? "", link));

  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => section !== null);

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((link, id) => {
            if (id === entry.target.id) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

---
import { contact, entities, products } from "../../utils/company";
import { getCurrentLanguage, getTranslation } from "../../utils/i18n";

const currentLang = getCurrentLanguage(Astro.url);
const t = getTranslation(currentLang);
const currentYear = new Date().getFullYear();
const homeLink = currentLang === "es" ? "/es/" : "/";
const entityLine = entities
  .map((entity) => `${entity.name} (${entity.place[currentLang]})`)
  .join(" · ");
---

<footer class="site-footer band-dark">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href={homeLink} class="site-footer__logo" aria-label={t.nav.home}>Aunova</a>
        <p class="site-footer__tagline">{t.footer.tagline}</p>
        <a
          href={contact.booking}
          class="button button--light"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.footer.bookCall}<span class="sr-only"> ({t.nav.newTab})</span>
        </a>
      </div>

      <div class="site-footer__columns">
        <div>
          <h2>{t.footer.company}</h2>
          <ul>
            <li><a href={`/${currentLang}/services`}>{t.footer.services}</a></li>
            <li><a href={`/${currentLang}/contact`}>{t.footer.contact}</a></li>
            {/* The blog is published in English only. */}
            <li><a href="/en/blog" hreflang="en">{t.footer.blog}</a></li>
          </ul>
        </div>

        <div>
          <h2>{t.footer.products}</h2>
          <ul>
            {
              products.map((product) => (
                <li>
                  <a href={product.url} target="_blank" rel="noopener">
                    {product.name}
                    <span class="sr-only"> ({t.nav.newTab})</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2>{t.footer.connect}</h2>
          <ul>
            <li>
              <a href={contact.linkedin} target="_blank" rel="noopener">
                LinkedIn<span class="sr-only"> ({t.nav.newTab})</span>
              </a>
            </li>
            <li>
              <a href={contact.bluesky} target="_blank" rel="noopener">
                Bluesky<span class="sr-only"> ({t.nav.newTab})</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {currentYear} Aunova. {t.footer.rights}</p>
      <p>{entityLine}</p>
      {/* Legal notices are published in English only. */}
      <ul class="site-footer__legal">
        <li><a href="/en/privacy" hreflang="en">{t.footer.privacy}</a></li>
        <li><a href="/en/terms" hreflang="en">{t.footer.terms}</a></li>
        <li>
          <a href="/en/privacy/newsletter" hreflang="en">{t.footer.newsletterPrivacy}</a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4xl);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) var(--space-xl);
    border-top: 1px solid var(--color-line-dark);
  }

  /* Pages that end in a dark band run straight into the footer */
  :global(main:has(> .flush-footer:last-child)) + .site-footer {
    margin-top: 0;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-3xl);
    padding-bottom: var(--space-3xl);
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .site-footer__logo {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-on-dark);
  }

  .site-footer__logo:hover {
    color: var(--color-on-dark);
    text-decoration: none;
    opacity: 0.85;
  }

  .site-footer__tagline {
    max-width: 26rem;
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: 1.45;
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .site-footer h2 {
    margin-bottom: var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ember);
  }

  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer li {
    margin-bottom: var(--space-sm);
  }

  .site-footer li a {
    font-size: var(--text-body-sm);
    color: var(--color-on-dark-muted);
  }

  .site-footer li a:hover {
    color: var(--color-on-dark);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-line-dark);
  }

  .site-footer__bottom p {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-on-dark-muted);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
  }

  .site-footer__legal li {
    margin: 0;
  }

  .site-footer__legal li a {
    font-size: var(--text-xs);
  }

  @media (max-width: 860px) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }

  @media (max-width: 540px) {
    .site-footer__columns {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

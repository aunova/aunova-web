---
import PageLayout from "../../layouts/PageLayout.astro";
import ContactForm from "../../components/ContactForm.astro";
import { contactStrings } from "../../i18n/contact";

const lang = "en";
const c = contactStrings[lang];
---

<PageLayout title={c.meta.title} description={c.meta.description} lang={lang}>
  <section class="contact-hero">
    <div class="container">
      <div class="hero-content">
        <h1>{c.title}</h1>
        <p class="hero-intro">{c.intro}</p>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-form-wrapper">
          <ContactForm lang={lang} />

          <p class="form-closing">{c.closing}</p>
        </div>

        <div class="contact-options">
          <div class="contact-card">
            <div class="card-content">
              <div class="contact-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </div>
              <h3>{c.options.call.title}</h3>
              <p>{c.options.call.text}</p>
            </div>
            <a
              href="https://cal.com/ngmisl/aunova"
              target="_blank"
              rel="noopener"
              class="btn btn-outline"
            >
              {c.options.call.button}
            </a>
          </div>

          <div class="contact-card">
            <div class="card-content">
              <div class="contact-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <h3>{c.options.email.title}</h3>
              <p>{c.options.email.text}</p>
            </div>
            <a href="mailto:info@aunova.net" class="btn btn-outline">
              info@aunova.net
            </a>
          </div>

          <div class="contact-card">
            <div class="card-content">
              <div class="contact-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                </svg>
              </div>
              <h3>{c.options.linkedin.title}</h3>
              <p>{c.options.linkedin.text}</p>
            </div>
            <a
              href="https://www.linkedin.com/company/aunova-ou/"
              target="_blank"
              rel="noopener"
              class="btn btn-outline"
            >
              {c.options.linkedin.button}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .contact-hero {
    padding: var(--space-3xl) 0;
    background: linear-gradient(
      135deg,
      var(--color-background) 0%,
      color-mix(in srgb, var(--color-surface) 60%, var(--color-background)) 100%
    );
  }

  .hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-content h1 {
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-lg);
  }

  .hero-intro {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .contact-section {
    padding: var(--space-3xl) 0 var(--space-5xl);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-3xl);
    max-width: 1100px;
    margin: 0 auto;
  }

  .contact-form-wrapper {
    background: var(--color-background-elevated, var(--color-white));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    min-width: 0;
  }

  .form-closing {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
  }

  .contact-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact-card {
    padding: var(--space-lg);
    background: var(--color-background-elevated, var(--color-white));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .contact-icon {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 48px;
    height: 48px;
    background: color-mix(in srgb, var(--color-primary) 10%, var(--color-background));
    border-radius: var(--radius-md);
    color: var(--color-primary);
  }

  .contact-card h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0;
    color: var(--color-text);
  }

  .contact-card p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-xl);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: var(--text-base);
    transition: all var(--transition-fast);
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
    font-size: var(--text-sm);
    padding: var(--space-sm) var(--space-md);
  }

  .btn-outline:hover {
    background-color: var(--color-primary);
    color: var(--color-white);
    text-decoration: none;
  }

  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .contact-options {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .contact-card {
      flex: 1;
      min-width: 200px;
    }
  }

  @media (max-width: 768px) {
    .contact-hero {
      padding: var(--space-2xl) 0;
    }

    .hero-content h1 {
      font-size: var(--text-3xl);
    }

    .hero-intro {
      font-size: var(--text-base);
    }

    .contact-section {
      padding: var(--space-2xl) 0 var(--space-3xl);
    }

    .contact-grid {
      gap: var(--space-xl);
    }

    .contact-form-wrapper {
      padding: var(--space-lg);
      border-radius: var(--radius-lg);
    }

    .contact-options {
      flex-direction: column;
    }

    .contact-card {
      min-width: unset;
    }

    .btn-outline {
      padding: var(--space-md) var(--space-lg);
      min-height: 44px;
    }
  }

  @media (max-width: 480px) {
    .contact-hero {
      padding: var(--space-xl) 0;
    }

    .hero-content h1 {
      font-size: var(--text-2xl);
    }

    .contact-section {
      padding: var(--space-xl) 0 var(--space-2xl);
    }

    .contact-form-wrapper {
      padding: var(--space-md);
    }
  }
</style>
